# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml — Ecosystem position of knot-knot.

[metadata]
project = "knot-knot"
ecosystem = "hyperpolymath"

[position]
type = "julia-library"
purpose = "KnotKnot.jl carries knot theory across the theory-practice divide: the diagram/invariant kernel (Gauss and PD codes, Jones/Alexander-Conway polynomials, quandles, Conway tangle calculus) serves the science side, while the applied layer (elastic-rod mechanics, capstan friction, bend-stress superposition, rope-efficiency prediction, flagellar waveform analysis, kinetoplast catenation) serves engineering and protistology. It is the estate's bridge package between pure knot theory and applied topology."
# IS-NOT — anti-identity (the boundary-erosion guard)
what-this-is-not = [
  "KnotTheory.jl (the estate's classical diagram/invariant engine; knot-knot bridges it, does not replace it)",
  "Skein.jl (the estate's skein/storage layer; knot-knot consumes its record format, does not fork it)",
  "Axiom.jl (the estate's ML/proof framework; knot-knot exports data to it, does not reimplement it)",
  "a visualiser in the KnotPlot sense — the web laboratory is one output surface, not the product",
  "a registry package (not in General; resolved by URL or by checkout)",
]

[pipeline]
position = "application"
chain = "KnotTheory.jl / Skein.jl (theory engines) -> knot-knot (bridge + applied science) -> Axiom.jl (learned models, proof export)"
notes = "knot-knot's diagram kernel is deliberately small and self-contained (stdlib-only) so the applied layers never depend on the registry availability of the theory engines; the interop/ environment connects to KnotTheory.jl and Skein.jl by URL for cross-validation."
coordination = "knot-knot is standalone (CLADE lineage); the knot cluster has no hub repo yet"

[related-projects]
projects = [
  { name = "hyperpolymath/KnotTheory.jl", relationship = "theory-engine", notes = "Classical diagrams, PD/DT/Gauss codes, Seifert matrices, polynomial invariants. knot-knot provides Gauss-code interop and defers deep table work to it." },
  { name = "hyperpolymath/Skein.jl", relationship = "skein-storage-engine", notes = "Skein relations, bracket polynomials, KnotRecord storage and queries. knot-knot emits compatible KnotRecord JSON." },
  { name = "hyperpolymath/Axiom.jl", relationship = "downstream-learner", notes = "Receives curvature/stress training data and verification exports from knot-knot's mechanics layer." },
  { name = "hyperpolymath/fraying-model-computational-testbed", relationship = "sibling-application", notes = "Uses Skein.jl Gauss codes for fragment-count distributions; shares the applied-topology orientation." },
  { name = "Proctist.jl", relationship = "planned-split", notes = "knot-knot's protistology module is deliberately self-contained so it can split out as Proctist.jl once its API stabilises; not yet minted." },
]
