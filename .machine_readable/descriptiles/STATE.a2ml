# STATE.a2ml — Project state checkpoint for knot-knot.
# Minted from hyperpolymath/rsr-template-repo (julia-library archetype)
# 2026-09-25; see .machine_readable/PROVENANCE.a2ml.

[metadata]
project = "knot-knot"
version = "0.1.0"
last-updated = "2026-09-25"
# status: active | paused | archived | planned
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it — never
# hand-edit both into agreement (standards#726).
status = "active"

[project-context]
name = "knot-knot"
purpose = "KnotKnot.jl — knot theory across the theory-practice divide: quandles, skein relations and Conway tangle calculus on the theory side; applied knot mechanics (capstan friction, bend-stress superposition, rope-efficiency prediction) and protistological topology (flagellar waveforms, kinetoplast catenation) on the practice side. Bridges the estate packages KnotTheory.jl and Skein.jl, and exports training/verification data for Axiom.jl."
completion-percentage = 70

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "alpha"         # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: Mint from rsr-template-repo (julia-library archetype)", completion = 100 },
  { name = "Phase 1: Diagram kernel — Gauss/PD codes, knot table, braid closure", completion = 100 },
  { name = "Phase 2: Invariants — Jones (Kauffman bracket), Alexander-Conway (Seifert), signature, determinant, genus", completion = 100 },
  { name = "Phase 3: Quandles — finite quandles, fundamental quandle presentation, colouring counts, dihedral/Alexander quandles", completion = 100 },
  { name = "Phase 4: Conway suite — rational tangle arithmetic, continued fractions, 2-bridge classification, skein-relation machinery", completion = 100 },
  { name = "Phase 5: Applied mechanics — elastic rods, curvature, bending energy, capstan tension propagation, stress superposition, rope efficiency", completion = 100 },
  { name = "Phase 6: Protistology — flagellar waveform analysis, writhe/linking (Gauss integrals), Calugareanu-White-Fuller identity, kinetoplast catenanes", completion = 100 },
  { name = "Phase 7: Bridge surfaces — Conway-suite report, JSON/visualisation export, KnotTheory.jl/Skein.jl interop adapters, Axiom.jl data hand-off", completion = 100 },
  { name = "Phase 8: Web laboratory — upgraded mechanics visualiser with quandle/skein/Conway annotations fed by Julia", completion = 90 },
  { name = "Phase 9: Estate registration — gv-clade-index entry, KnotTheory/Skein interop CI job, Proctist.jl split-out assessment", completion = 0 },
]

[blockers-and-issues]
# 1. Julia toolchain is NOT reachable from some sandboxed build environments
#    (AWS-S3 egress blocked); local iteration relies on GitHub Actions
#    (julia-actions/setup-julia) as the ground-truth runner. Recorded so a
#    future agent does not burn cycles re-deriving this.
# 2. KnotTheory.jl/Skein.jl are not in the General registry; the interop
#    environment (interop/Project.toml) resolves them by URL and is exercised
#    on demand (`just interop`), not in the MUST CI path.

[critical-next-actions]
actions = [
  "Owner: ratify the CLADE choice (dx/fv) or reassign; rationale recorded in CLADE.a2ml",
  "Owner: register the minted uuid a6cbd9d9-f370-519d-a0d0-9d00bf3e780b in gv-clade-index",
  "Add a CI job that runs interop/Project.toml against hyperpolymath/KnotTheory.jl + Skein.jl by URL once their dependency closure (AcceleratorGate) is registry-resolvable",
  "Assess splitting src/protistology.jl out as Proctist.jl once the API stabilises (estate boundary decision, not a mechanical move)",
  "Wire an Axiom.jl example that learns the curvature->stress map from KnotKnot mechanics exports",
  "Replace the docs/ Documenter deploy-key gap: provision DOCUMENTER_KEY or downgrade julia-docs.yml to build-only (see docs/decisions/0002)",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["hyperpolymath knot-theory cluster"]
depends-on = []  # runtime deps: Julia stdlib only (see Project.toml); KnotTheory/Skein interop is URL-resolved and optional

[test-suite-shape]
# julia-library archetype records the suite honestly: Aqua shape gate first,
# then behavioural cases under test/cases/.
shape = "Aqua + behavioural cases (gauss, jones, alexander, quandles, braids, tangles, skein, mechanics, protistology, report)"
